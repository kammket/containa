{
  // CommonJS-Build für die NestJS-API.
  //
  // Die Storefront bindet den Katalog als TypeScript-Quelle ein (Bundler-
  // Resolution, gutes Tree-Shaking). Die API läuft dagegen als CommonJS und
  // kann ESM-Quellen nicht per require() laden – daher dieser zweite Build.
  // Die exports-Map in package.json führt beide Welten zusammen.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist/cjs",
    "declaration": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
