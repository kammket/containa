{
  "name": "@emc/catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zentrale Produkt-, Kategorie- und SEO-Datenquelle f\u00fcr EMC Container",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node scripts/finalize-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/catalog.test.ts",
    "build:esm": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
