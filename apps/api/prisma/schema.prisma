// EMC Container – Datenmodell
//
// Der Shop arbeitet ohne Kundenkonten: Bestellungen laufen als Gast-Checkout,
// Kundendaten hängen direkt an der Bestellung. Einzige Benutzer im System sind
// Administratoren, die Produkte pflegen sowie Bestellungen und Anfragen einsehen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── Verwaltung ──

enum AdminRole {
  OWNER
  EDITOR
}

/// Administratoren. Angelegt wird ausschließlich über den Seed bzw. durch
/// einen bestehenden OWNER – eine öffentliche Registrierung gibt es nicht.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Fehlgeschlagene Loginversuche für die Sperrlogik
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

/// Rotierende Refresh-Tokens. Gespeichert wird nur der Hash, damit ein
/// Datenbankleck keine gültigen Tokens preisgibt.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Nachvollziehbarkeit administrativer Änderungen.
model AuditLog {
  id       String     @id @default(cuid())
  userId   String?
  user     AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  /// Geänderte Felder als JSON-Momentaufnahme
  changes  Json?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ────────────────────────────────────────────────────────────────── Katalog ──

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  navLabel String
  tagline  String
  /// Menügruppe: groessen | zustand | bauart | ausbau
  menuGroup String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuGroup, sortOrder])
  @@map("categories")
}

enum ProductCondition {
  NEU
  ONE_TRIP
  GENERALUEBERHOLT
  GEBRAUCHT
}

enum Availability {
  AUF_LAGER
  KURZFRISTIG
  AUF_ANFRAGE
  AUSVERKAUFT
}

model Product {
  id      String @id @default(cuid())
  slug    String @unique
  sku     String @unique
  name    String
  tagline String

  /// Beschreibungsabsätze
  description String[]
  highlights  String[]

  condition    ProductCondition
  /// Größenklasse: 8ft | 10ft | 20ft | 40ft | 45ft | sonder
  size         String
  availability Availability     @default(AUF_LAGER)

  /// Alle Beträge als Nettobetrag in Cent – keine Fließkommazahlen für Geld
  priceNet     Int
  compareAtNet Int?

  stock            Int  @default(0)
  leadTimeDaysMin  Int  @default(3)
  leadTimeDaysMax  Int  @default(7)
  warrantyMonths   Int  @default(12)

  /// Außenmaße in Millimetern – bestimmen u. a. die Lieferpauschale
  lengthMm Int
  widthMm  Int
  heightMm Int

  /// Technische Daten als strukturiertes JSON (Spezifikationstabelle)
  specs    Json?
  specRows Json?
  faqs     Json?

  isFeatured   Boolean @default(false)
  isBestseller Boolean @default(false)
  isActive     Boolean @default(true)

  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  /// Weitere Suchbegriffe für die semantische interne Verlinkung
  secondaryKeywords String[]

  /// Begriffe für die Instant-Suche der Storefront – ohne sie findet die Suche
  /// ein Produkt nur über Name und Kurztext
  keywords String[]

  /// Kuratierte verwandte Produkte als Slugs. Leer heißt: Die Storefront füllt
  /// aus derselben Kategorie auf.
  relatedSlugs String[]

  images     ProductImage[]
  categories ProductCategory[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isBestseller])
  @@index([size, condition])
  @@map("products")
}

/// Verknüpfungstabelle Produkt ↔ Kategorie (n:m)
model ProductCategory {
  productId  String
  categoryId String
  /// true für die Primärkategorie – bestimmt Breadcrumb und kanonischen Pfad
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Cloudinary public ID
  publicId String
  /// Vollständige URL (denormalisiert, spart einen Aufbau je Anfrage)
  url      String
  alt      String
  width    Int     @default(1200)
  height   Int     @default(900)
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ──────────────────────────────────────────────────────────── Bestellungen ──

enum OrderStatus {
  EINGEGANGEN
  ZAHLUNG_AUSSTEHEND
  BEZAHLT
  IN_BEARBEITUNG
  VERSANDBEREIT
  IN_ZUSTELLUNG
  GELIEFERT
  STORNIERT
  ERSTATTET
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  SEPA
  BANKTRANSFER
  INVOICE
}

enum PaymentStatus {
  OFFEN
  AUTORISIERT
  BEZAHLT
  FEHLGESCHLAGEN
  ERSTATTET
  TEILERSTATTET
}

enum CustomerType {
  PRIVAT
  GEWERBLICH
}

model Order {
  id          String @id @default(cuid())
  /// Menschenlesbare Nummer, z. B. EMC-2026-04821
  orderNumber String @unique

  /// Gast-Checkout: Kundendaten hängen direkt an der Bestellung
  email        String
  customerType CustomerType @default(PRIVAT)
  vatId        String?

  status OrderStatus @default(EINGEGANGEN)

  /// Beträge als Nettobetrag in Cent
  subtotalNet Int
  discountNet Int @default(0)
  shippingNet Int @default(0)
  vatAmount   Int
  totalGross  Int
  vatRate     Decimal @default(0.19) @db.Decimal(4, 4)

  couponCode    String?
  deliveryNotes String?

  /// Voraussichtlicher Liefertermin, von der Disposition gepflegt
  estimatedDelivery DateTime?
  carrier           String?

  billingAddress  Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingAddressId String?  @unique

  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId String?  @unique

  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?
  events   OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model Address {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  company     String?
  street      String
  houseNumber String
  postalCode  String
  city        String
  country     String  @default("DE")
  phone       String

  billingFor  Order? @relation("BillingAddress")
  shippingFor Order? @relation("ShippingAddress")

  createdAt DateTime @default(now())

  @@map("addresses")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Produktdaten zum Bestellzeitpunkt festgehalten. Ändert sich später der
  /// Katalogpreis, bleibt die Bestellung nachvollziehbar.
  sku      String
  slug     String
  name     String
  priceNet Int
  quantity Int
  lineNet  Int

  @@index([orderId])
  @@map("order_items")
}

/// Statusverlauf einer Bestellung – Grundlage der Sendungsverfolgung.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      OrderStatus
  label       String
  description String
  /// Nur intern sichtbar, nicht in der Sendungsverfolgung
  isInternal  Boolean     @default(false)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  status   PaymentStatus @default(OFFEN)
  amount   Int
  currency String        @default("EUR")

  /// Referenz beim Zahlungsanbieter (Stripe PaymentIntent, PayPal Order …)
  providerReference String?
  /// Rohantwort des Anbieters für Nachvollziehbarkeit bei Reklamationen
  providerPayload   Json?

  paidAt     DateTime?
  refundedAt DateTime?
  refundedAmount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([providerReference])
  @@map("payments")
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  issuedAt DateTime  @default(now())
  dueAt    DateTime
  paidAt   DateTime?

  netAmount   Int
  vatAmount   Int
  grossAmount Int

  /// Cloudinary- bzw. Speicher-URL des erzeugten PDFs
  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// ────────────────────────────────────────────────────────────────── Anfragen ──

enum InquiryType {
  KONTAKT
  ANGEBOT
}

enum InquiryStatus {
  NEU
  IN_BEARBEITUNG
  BEANTWORTET
  GESCHLOSSEN
}

/// Kontaktanfragen und Angebotsanfragen aus den Formularen der Website.
model Inquiry {
  id        String        @id @default(cuid())
  /// Referenz für die Rückmeldung an Kundinnen und Kunden, z. B. ANF-2026-0142
  reference String        @unique
  type      InquiryType
  status    InquiryStatus @default(NEU)

  name    String
  email   String
  phone   String?
  company String?

  /// Nur bei Kontaktanfragen
  subject String?
  message String?

  /// Nur bei Angebotsanfragen
  customerType CustomerType?
  productSlug  String?
  size         String?
  condition    String?
  quantity     Int?
  postalCode   String?
  deliveryDate DateTime?
  usage        String?

  /// Interne Notiz der Bearbeitung
  internalNote String?
  handledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([email])
  @@map("inquiries")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  /// Double-Opt-in: erst nach Bestätigung wird versendet
  confirmedAt    DateTime?
  confirmToken   String?   @unique
  unsubscribedAt DateTime?
  ipAddress      String?

  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  type CouponType

  /// Bei PERCENT der Prozentwert, bei FIXED der Nettobetrag in Cent
  value Int

  /// Mindestbestellwert netto in Cent
  minSubtotalNet Int  @default(0)
  maxRedemptions Int?
  redemptions    Int  @default(0)

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}
