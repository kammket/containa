# ─────────────────────────────────────────────────────────────────────────────
# EMC Container – API
#
# Kopieren nach .env.local (Entwicklung) bzw. als Umgebungsvariablen in
# Railway hinterlegen (Produktion). Niemals ins Repository einchecken.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Datenbank (erforderlich) ─────────────────────────────────────────────────
# Railway stellt DATABASE_URL beim Anlegen des Postgres-Dienstes automatisch bereit.
DATABASE_URL="postgresql://emc:emc_dev_password@localhost:5432/emc_container?schema=public"

# ── Sicherheit (erforderlich) ────────────────────────────────────────────────
# Jeweils mindestens 32 Zeichen, alle drei unterschiedlich.
# Erzeugen mit: openssl rand -base64 48
JWT_SECRET="hier-ein-zufaelliges-geheimnis-mit-mindestens-32-zeichen"
JWT_REFRESH_SECRET="ein-anderes-zufaelliges-geheimnis-mit-32-zeichen-plus"
COOKIE_SECRET="noch-ein-drittes-geheimnis-mit-mindestens-32-zeichen"

# Laufzeit des Access-Tokens. Das Refresh-Token gilt fest 7 Tage.
JWT_EXPIRES_IN=15m

# ── Netzwerk ─────────────────────────────────────────────────────────────────
# Kommagetrennte Liste der Frontend-Domains, die die API ansprechen dürfen.
# In Produktion zwingend auf die echte Domain setzen – niemals "*".
CORS_ORIGINS=http://localhost:3000

# Öffentliche URL der Storefront (für Zahlungs-Weiterleitungen, E-Mail-Links
# und die Benachrichtigung nach Produktänderungen).
APP_URL=http://localhost:3000

# Gemeinsames Geheimnis mit der Storefront. Nach jeder Produktänderung im
# Adminbereich meldet die API das an APP_URL/api/revalidate; die betroffenen
# Seiten werden dann sofort neu erzeugt. Ohne diesen Wert unterbleibt die
# Meldung – die Storefront erneuert sich dann von selbst nach einer Minute.
# Muss identisch zu REVALIDATE_SECRET der Storefront sein.
#   openssl rand -base64 32
REVALIDATE_SECRET=

# Swagger ist in Produktion standardmäßig aus. Nur bewusst aktivieren.
ENABLE_SWAGGER=false

# ── Erstes Administratorkonto (nur für den Seed) ─────────────────────────────
# Ohne ADMIN_PASSWORD erzeugt der Seed eines und gibt es einmalig aus.
ADMIN_EMAIL=admin@emccontainer.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── Cloudinary (optional) ────────────────────────────────────────────────────
# Ohne diese Werte ist der Bildupload deaktiviert; die Storefront zeigt dann
# generierte Platzhalter statt Produktfotos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── E-Mail (optional) ────────────────────────────────────────────────────────
# Ohne SMTP_HOST werden E-Mails nur protokolliert, nicht versendet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EMC Container <info@emccontainer.com>"

# Interne Adresse für Benachrichtigungen über neue Bestellungen und Anfragen.
ADMIN_NOTIFY_EMAIL=vertrieb@emccontainer.com


# ── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL=
