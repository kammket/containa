# ─────────────────────────────────────────────────────────────────────────────
# EMC Container – Storefront
#
# Kopieren nach .env.local (Entwicklung) bzw. in Vercel als Projekt-
# Umgebungsvariablen hinterlegen.
#
# Achtung: Alle mit NEXT_PUBLIC_ beginnenden Werte landen im Browser-Bundle
# und sind öffentlich. Niemals Geheimnisse mit diesem Präfix versehen.
# ─────────────────────────────────────────────────────────────────────────────

# Basis-URL der API. In Produktion die öffentliche Railway-Domain eintragen.
# Wird sowohl im Browser (Formulare, Adminbereich) als auch serverseitig für
# den Produktkatalog verwendet.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: abweichende Adresse für serverseitige Abrufe, etwa eine interne
# Netzadresse. Ohne diesen Wert gilt NEXT_PUBLIC_API_URL.
API_URL=

# Gemeinsames Geheimnis mit der API. Damit meldet der Adminbereich Änderungen
# an Produkten, damit die Storefront sie sofort statt nach einer Minute zeigt.
# Muss identisch zu REVALIDATE_SECRET der API sein.
#   openssl rand -base64 32
REVALIDATE_SECRET=

# Cloudinary-Cloud für Produktbilder. Ohne diesen Wert erzeugt die Storefront
# deterministische SVG-Platzhalter – die Seite bleibt vollständig nutzbar.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
